# LLM provider configuration.
# LLM_API_URL is the OpenAI-compatible base URL, for example https://api.deepseek.com.
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=<YOUR API KEY>
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# Default to non-thinking mode. OpenAI-compatible providers that support
# enable_thinking will receive extra_body={"enable_thinking": false}.
LLM_THINKING_ENABLED=false
LLM_DISABLE_THINKING_PARAM=enable_thinking
LLM_THINKING_DISABLED_BODY={"thinking":{"type":"disabled"}}
LLM_REJECT_REASONING_WHEN_DISABLED=true
